#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 9;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x55b0792ee600 .scope module, "flipflopD_tb" "flipflopD_tb" 2 4;
 .timescale -9 -9;
v0x55b0793012c0_0 .var "Clk", 0 0;
v0x55b079301380_0 .var "D", 0 0;
v0x55b079301450_0 .net "Q", 0 0, v0x55b079301080_0;  1 drivers
v0x55b079301550_0 .var "rst", 0 0;
S_0x55b0792ee790 .scope module, "f" "flipflopD" 2 9, 3 1 0, S_0x55b0792ee600;
 .timescale -9 -9;
    .port_info 0 /INPUT 1 "D";
    .port_info 1 /INPUT 1 "Clk";
    .port_info 2 /INPUT 1 "rst";
    .port_info 3 /OUTPUT 1 "Q";
v0x55b0792b6c00_0 .net "Clk", 0 0, v0x55b0793012c0_0;  1 drivers
v0x55b079300fc0_0 .net "D", 0 0, v0x55b079301380_0;  1 drivers
v0x55b079301080_0 .var "Q", 0 0;
v0x55b079301150_0 .net "rst", 0 0, v0x55b079301550_0;  1 drivers
E_0x55b0792b5480 .event posedge, v0x55b079301150_0, v0x55b0792b6c00_0;
    .scope S_0x55b0792ee790;
T_0 ;
    %wait E_0x55b0792b5480;
    %load/vec4 v0x55b079301150_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v0x55b079301080_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x55b079300fc0_0;
    %assign/vec4 v0x55b079301080_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x55b0792ee600;
T_1 ;
    %delay 5, 0;
    %load/vec4 v0x55b0793012c0_0;
    %inv;
    %store/vec4 v0x55b0793012c0_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x55b0792ee600;
T_2 ;
    %vpi_call 2 15 "$dumpfile", "flipflopD.vcd" {0 0 0};
    %vpi_call 2 16 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55b0792ee600 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55b0793012c0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55b079301380_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55b079301550_0, 0, 1;
    %delay 12, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55b079301550_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55b079301380_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55b079301380_0, 0, 1;
    %delay 20, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55b079301380_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55b079301550_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55b079301550_0, 0, 1;
    %delay 20, 0;
    %vpi_call 2 29 "$display", "Test Complete!" {0 0 0};
    %vpi_call 2 30 "$finish" {0 0 0};
    %end;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "flipflopD_tb.v";
    "./flipflopD.v";
