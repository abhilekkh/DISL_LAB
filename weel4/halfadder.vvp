:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x55f8e1918120 .scope module, "halfadder_tb" "halfadder_tb" 2 4;
 .timescale -9 -9;
v0x55f8e192a070_0 .var "a", 0 0;
v0x55f8e192a130_0 .var "b", 0 0;
v0x55f8e192a200_0 .net "carry", 0 0, L_0x55f8e192a530;  1 drivers
v0x55f8e192a300_0 .net "sum", 0 0, L_0x55f8e192a3d0;  1 drivers
S_0x55f8e19182b0 .scope module, "o" "halfadder" 2 7, 3 1 0, S_0x55f8e1918120;
 .timescale -9 -9;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "sum";
    .port_info 3 /OUTPUT 1 "carry";
L_0x55f8e192a3d0 .functor XOR 1, v0x55f8e192a070_0, v0x55f8e192a130_0, C4<0>, C4<0>;
L_0x55f8e192a530 .functor AND 1, v0x55f8e192a070_0, v0x55f8e192a130_0, C4<1>, C4<1>;
v0x55f8e18decf0_0 .net "a", 0 0, v0x55f8e192a070_0;  1 drivers
v0x55f8e1929d70_0 .net "b", 0 0, v0x55f8e192a130_0;  1 drivers
v0x55f8e1929e30_0 .net "carry", 0 0, L_0x55f8e192a530;  alias, 1 drivers
v0x55f8e1929f00_0 .net "sum", 0 0, L_0x55f8e192a3d0;  alias, 1 drivers
    .scope S_0x55f8e1918120;
T_0 ;
    %vpi_call 2 9 "$dumpfile", "halfadder.vcd" {0 0 0};
    %vpi_call 2 10 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55f8e1918120 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55f8e192a070_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55f8e192a130_0, 0, 1;
    %delay 20, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55f8e192a070_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55f8e192a130_0, 0, 1;
    %delay 20, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55f8e192a070_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55f8e192a130_0, 0, 1;
    %delay 20, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55f8e192a070_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55f8e192a130_0, 0, 1;
    %delay 20, 0;
    %vpi_call 2 19 "$display", "Test complete" {0 0 0};
    %end;
    .thread T_0;
