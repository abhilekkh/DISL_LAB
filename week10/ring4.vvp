:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x55a7370c2880 .scope module, "ring4_tb" "ring4_tb" 2 3;
 .timescale -9 -9;
v0x55a7370d3920_0 .var "clk", 0 0;
v0x55a7370d39f0_0 .net "q", 3 0, v0x55a7370d3720_0;  1 drivers
v0x55a7370d3ac0_0 .var "rst", 0 0;
S_0x55a7370c2a10 .scope module, "uut" "ring4" 2 9, 3 1 0, S_0x55a7370c2880;
 .timescale -9 -9;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst";
    .port_info 2 /OUTPUT 4 "q";
v0x55a73708ac00_0 .net "clk", 0 0, v0x55a7370d3920_0;  1 drivers
v0x55a7370d3720_0 .var "q", 3 0;
v0x55a7370d3800_0 .net "rst", 0 0, v0x55a7370d3ac0_0;  1 drivers
E_0x55a7370891f0 .event posedge, v0x55a7370d3800_0, v0x55a73708ac00_0;
    .scope S_0x55a7370c2a10;
T_0 ;
    %wait E_0x55a7370891f0;
    %load/vec4 v0x55a7370d3800_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 1, 0, 4;
    %assign/vec4 v0x55a7370d3720_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x55a7370d3720_0;
    %parti/s 3, 0, 2;
    %load/vec4 v0x55a7370d3720_0;
    %parti/s 1, 3, 3;
    %concat/vec4; draw_concat_vec4
    %assign/vec4 v0x55a7370d3720_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x55a7370c2880;
T_1 ;
    %delay 5, 0;
    %load/vec4 v0x55a7370d3920_0;
    %inv;
    %store/vec4 v0x55a7370d3920_0, 0, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_0x55a7370c2880;
T_2 ;
    %vpi_call 2 20 "$dumpfile", "ring4.vcd" {0 0 0};
    %vpi_call 2 21 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55a7370c2880 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55a7370d3920_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x55a7370d3ac0_0, 0, 1;
    %delay 12, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x55a7370d3ac0_0, 0, 1;
    %delay 100, 0;
    %vpi_call 2 31 "$finish" {0 0 0};
    %end;
    .thread T_2;
